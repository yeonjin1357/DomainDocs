---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---
<BaseLayout>
  <section class="hero">
    <h1 class="hero-title" data-page-title>{SITE.headline.split('\n').map((line) => <span>{line}</span>)}</h1>
    <p class="hero-desc">{SITE.description}</p>
  </section>
</BaseLayout>
