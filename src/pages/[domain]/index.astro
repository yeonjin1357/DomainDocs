---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/ui/Card.astro';
import ListRow from '../../components/ui/ListRow.astro';
import { DOMAINS, type Domain } from '../../data/domains';
import { domainSections, inDomain, TYPE_LABEL, type DocCard } from '../../lib/catalog';
import { getCards } from '../../lib/content';
import { withBase } from '../../lib/paths';

export const getStaticPaths = (async () => {
  const cards = await getCards();
  return DOMAINS.filter((d) => inDomain(cards, d.id).length > 0).map((domain) => ({ params: { domain: domain.id }, props: { domain } }));
}) satisfies GetStaticPaths;

interface Props {
  domain: Domain;
}

const { domain } = Astro.props;
const sections = domainSections(inDomain(await getCards(), domain.id));
// 위에서부터 한눈에 보기 → 기초 → 모니터링에서는 → 상황 가이드. 빈 묶음은 숨긴다.
const cards = [
  { title: '한눈에 보기', docs: sections.overview },
  { title: '기초', docs: sections.basics },
  { title: '모니터링에서는', docs: sections.monitoring },
  { title: '상황 가이드', docs: sections.guides },
].filter((c) => c.docs.length > 0);
const metaOf = (d: DocCard) => `${TYPE_LABEL[d.type]} · ${d.readingMinutes}분`;
---
<BaseLayout title={domain.name} description={domain.description} surface="grey" backHref={withBase()} barTitle={domain.name}>
  <section class="hero">
    <h1 class="hero-title" data-page-title>{domain.name}</h1>
    <p class="hero-desc">{domain.description}</p>
  </section>
  {
    cards.map((c) => (
      <Card title={c.title}>
        {c.docs.map((d) => <ListRow href={d.url} icon={d.icon} title={d.title} description={d.summary} meta={metaOf(d)} />)}
      </Card>
    ))
  }
</BaseLayout>
