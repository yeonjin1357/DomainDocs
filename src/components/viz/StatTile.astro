---
interface Props {
  label: string;
  value: string;
  unit?: string;
  tone?: 'default' | 'accent' | 'warn';
  note?: string;
}
const { label, value, unit, tone = 'default', note } = Astro.props;
---
<div class:list={['stat', `tone-${tone}`]} data-stat>
  <span class="stat-label">{label}</span>
  <span class="stat-value">{value}{unit && <span class="stat-unit">{unit}</span>}</span>
  {note && <span class="stat-note">{note}</span>}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--color-card);
    container-type: inline-size;
  }

  .stat-label {
    font-size: 14px;
    color: var(--color-text-sub);
  }

  /* 이름이 두 줄로 넘어가도 옆 타일과 숫자 높이를 맞춘다.
     숫자 크기는 타일 폭을 따른다: 360px 화면에 타일 둘이 나란히 서면 숫자 칸이 100px이라,
     24px로는 "210,000개"의 단위나 "데이터 없음"이 다음 줄로 갈라진다.
     cqi를 모르는 브라우저는 clamp 줄을 버리고 앞 줄의 24px을 쓴다(물려받은 17px이 아니라). */
  .stat-value {
    margin-top: auto;
    font-size: 24px;
    font-size: clamp(20px, 20cqi, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .stat-unit {
    margin-left: 2px;
    font-size: 15px;
    font-weight: 600;
  }

  .stat-note {
    font-size: 13px;
    color: var(--color-text-sub);
  }

  .tone-accent .stat-value {
    color: var(--color-accent);
  }

  .tone-warn .stat-value {
    color: var(--color-warn);
  }
</style>
