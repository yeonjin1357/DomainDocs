---
import { FLOW, layoutFlow, type FigureTone, type FlowEdge, type FlowGroup, type FlowNode } from '../../lib/viz/flow';
import { svgId } from '../../lib/viz/svg-id';

interface Props {
  nodes: FlowNode[];
  edges: FlowEdge[];
  groups?: FlowGroup[];
  ariaLabel: string;
}

const { nodes, edges, groups = [], ariaLabel } = Astro.props;
const layout = layoutFlow(nodes, edges, groups);
const uid = svgId('flow', ariaLabel);
const TONES: FigureTone[] = ['sub', 'accent', 'warn'];
const marker = (tone: FigureTone) => `url(#${uid}-${tone})`;
---
<svg
  class="flow"
  data-flow
  viewBox={`0 0 ${layout.width} ${layout.height}`}
  role="img"
  aria-label={ariaLabel}
  style={`max-width:${Math.round(layout.width * 1.3)}px`}
>
  <defs>
    {
      TONES.map((tone) => (
        <marker id={`${uid}-${tone}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path class={`head tone-${tone}`} d="M0,0 L10,5 L0,10 z" />
        </marker>
      ))
    }
  </defs>
  {
    layout.groups.map((g) => (
      <>
        <rect class="flow-group" x={g.x} y={g.y} width={g.w} height={g.h} rx="12" />
        {/* 이름은 아래 왼쪽에 둔다. 위쪽은 첫 줄 상자와 겹친다. */}
        <text class="group-label" x={g.x + 8} y={g.y + g.h - 6}>{g.label}</text>
      </>
    ))
  }
  {
    layout.edges.map((e) => (
      <line
        class:list={['flow-edge', `tone-${e.tone}`, { dashed: e.dashed }]}
        x1={e.x1}
        y1={e.y1}
        x2={e.x2}
        y2={e.y2}
        marker-end={marker(e.tone)}
        marker-start={e.both ? marker(e.tone) : undefined}
      />
    ))
  }
  {
    layout.nodes.map((n) => (
      <>
        <rect class={`flow-node tone-${n.tone ?? 'sub'}`} x={n.cx - FLOW.nodeW / 2} y={n.cy - FLOW.nodeH / 2} width={FLOW.nodeW} height={FLOW.nodeH} rx="10" />
        <text class="flow-label" x={n.cx} y={n.note ? n.cy - 7 : n.cy}>{n.label}</text>
        {n.note && <text class="flow-note" x={n.cx} y={n.cy + 9}>{n.note}</text>}
      </>
    ))
  }
  {layout.edges.filter((e) => e.label).map((e) => <text class="edge-label" x={e.lx} y={e.ly}>{e.label}</text>)}
</svg>

<style>
  .flow {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  text {
    dominant-baseline: central;
    text-anchor: middle;
    font-family: inherit;
  }

  .flow-node {
    fill: var(--color-card);
    stroke-width: 1.5;
  }

  .flow-node.tone-sub {
    stroke: var(--color-line);
  }

  .flow-node.tone-accent {
    stroke: var(--color-accent);
  }

  .flow-node.tone-warn {
    stroke: var(--color-warn);
  }

  .flow-label {
    font-size: 13px;
    font-weight: 600;
    fill: var(--color-text);
  }

  .flow-note {
    font-size: 11px;
    fill: var(--color-text-sub);
  }

  .flow-edge {
    stroke-width: 1.5;
  }

  .flow-edge.tone-sub,
  .flow-edge.tone-accent {
    stroke: var(--color-text-weak);
  }

  .flow-edge.tone-warn {
    stroke: var(--color-warn);
    stroke-width: 2;
  }

  .flow-edge.dashed {
    stroke-dasharray: 4 3;
  }

  .head.tone-sub,
  .head.tone-accent {
    fill: var(--color-text-weak);
  }

  .head.tone-warn {
    fill: var(--color-warn);
  }

  /* 선 위 글자는 바탕색 테두리로 선을 가려 읽히게 한다 */
  .edge-label {
    font-size: 11px;
    fill: var(--color-text-sub);
    paint-order: stroke;
    stroke: var(--color-bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .flow-group {
    fill: none;
    stroke: var(--color-text-weak);
    stroke-dasharray: 4 3;
  }

  .group-label {
    font-size: 11px;
    text-anchor: start;
    fill: var(--color-text-sub);
  }
</style>
