---
import { layoutAnatomy, type AnatomyPart } from '../../lib/viz/anatomy';

interface Props {
  /** 앞에서부터 이름을 이루는 조각 */
  parts: AnatomyPart[];
  ariaLabel: string;
}

const { parts, ariaLabel } = Astro.props;
const layout = layoutAnatomy(parts);
// 이름이 길면 글자를 줄여 360px 한 줄에 들어가게 한다
const size = layout.text.length > 22 ? 15 : layout.text.length > 14 ? 18 : 22;
---
<div class="anatomy" data-anatomy role="img" aria-label={ariaLabel}>
  <p class="anatomy-name" style={`--size:${size}px`}>
    {
      layout.parts.map((p) => (
        <span class={`anatomy-piece tone-${p.tone ?? 'plain'}`}>
          <code class="anatomy-text">{p.text}</code>
          {p.number && <span class="anatomy-no">{p.number}</span>}
        </span>
      ))
    }
  </p>
  <ol class="anatomy-legend">
    {
      layout.parts
        .filter((p) => p.number)
        .map((p) => (
          <li class={`tone-${p.tone ?? 'plain'}`}>
            <span class="anatomy-no">{p.number}</span>
            <code class="anatomy-legend-text">{p.text}</code>
            <span class="anatomy-label">{p.label}</span>
            {p.note && <span class="anatomy-note">{p.note}</span>}
          </li>
        ))
    }
  </ol>
</div>

<style>
  .anatomy {
    display: grid;
    gap: 14px;
  }

  /* 이름 한 줄. 조각마다 밑줄과 번호를 달아 아래 뜻 목록과 짝을 맞춘다 */
  .anatomy-name {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 3px;
    margin: 0;
  }

  .anatomy-piece {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .anatomy-text {
    padding: 2px 3px 4px;
    border-bottom: 3px solid var(--color-accent);
    background: none;
    font-size: var(--size);
    font-weight: 700;
    color: var(--color-text);
  }

  .anatomy-piece.tone-sub .anatomy-text {
    border-bottom-color: transparent;
    color: var(--color-text-weak);
  }

  .anatomy-piece.tone-warn .anatomy-text {
    border-bottom-color: var(--color-warn);
  }

  .anatomy-no {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-accent);
    font-size: 11px;
    font-weight: 700;
    color: #fff;
  }

  .tone-warn > .anatomy-no {
    background: var(--color-warn);
  }

  .anatomy-legend {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .anatomy-legend li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--color-card);
    font-size: 14px;
  }

  .anatomy-legend .anatomy-no {
    align-self: center;
  }

  .anatomy-legend-text {
    font-weight: 700;
    background: none;
  }

  .anatomy-label {
    font-weight: 600;
  }

  .anatomy-note {
    font-size: 12.5px;
    color: var(--color-text-sub);
  }
</style>
