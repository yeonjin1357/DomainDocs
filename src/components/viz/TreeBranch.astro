---
import type { TreeNode } from '../../lib/viz/tree';

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
const children = node.children ?? [];
---
<li class="tree-item">
  <div class={`tree-node tone-${node.tone ?? 'plain'}`}>
    <span class="tree-text">
      <span class="tree-label">{node.label}</span>
      {node.note && <span class="tree-note">{node.note}</span>}
    </span>
    {node.tag && <code class="tree-tag">{node.tag}</code>}
  </div>
  {
    children.length > 0 && (
      <ul class="tree-children">
        {children.map((c) => (
          <Astro.self node={c} />
        ))}
      </ul>
    )
  }
</li>

<style>
  .tree-item {
    position: relative;
  }

  .tree-children {
    display: grid;
    gap: 6px;
    margin: 6px 0 0;
    padding: 0 0 0 22px;
    list-style: none;
  }

  /* 부모에서 내려오는 세로선과 마디로 꺾이는 선. 마지막 아이는 세로선을 꺾인 곳에서 끝낸다 */
  .tree-children > .tree-item::before {
    content: '';
    position: absolute;
    top: -6px;
    left: -12px;
    width: 10px;
    height: 24px;
    border-bottom: 1.5px solid var(--color-text-weak);
    border-left: 1.5px solid var(--color-text-weak);
    border-bottom-left-radius: 6px;
  }

  .tree-children > .tree-item:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: -6px;
    left: -12px;
    border-left: 1.5px solid var(--color-text-weak);
  }

  .tree-node {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 6px 10px;
    border: 1.5px solid transparent;
    border-radius: 10px;
    background: var(--color-card);
  }

  .tree-node.tone-accent {
    border-color: var(--color-accent);
    background: var(--color-accent-weak);
  }

  .tree-node.tone-warn {
    border-color: var(--color-warn);
    background: var(--color-warn-weak);
  }

  .tree-node.tone-sub {
    border: 1.5px dashed var(--color-line);
    background: transparent;
    color: var(--color-text-sub);
  }

  .tree-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
    min-width: 0;
    margin-right: auto;
  }

  .tree-label {
    font-size: 14px;
    font-weight: 600;
  }

  .tree-note {
    font-size: 12.5px;
    color: var(--color-text-sub);
  }

  .tree-tag {
    flex: none;
    font-size: 12px;
    color: var(--color-accent);
    background: none;
  }

  .tree-node.tone-warn .tree-tag {
    color: var(--color-warn);
  }
</style>
