---
interface Props {
  id: string;
  label: string;
  variant?: 'sheet' | 'full';
}
const { id, label, variant = 'sheet' } = Astro.props;
---
<dialog id={id} class:list={['sheet', `sheet-${variant}`]} aria-label={label} data-sheet>
  <div class="sheet-panel" data-sheet-panel>
    {variant === 'sheet' && <div class="sheet-handle" data-sheet-handle aria-hidden="true"></div>}
    <slot />
  </div>
</dialog>

<style>
  .sheet {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .sheet[open] {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  /* 브라우저 기본값은 모달 dialog가 스크롤을 허용한다. 패널이 아래에서 올라오거나 끌려 내려가는
     동안 틀 밖으로 나가면 스크롤바가 생기고, 열 때 첫 버튼에 포커스가 가며 틀이 스크롤돼
     시트가 위로 떴다가 내려앉는다. clip은 틀을 스크롤할 수 없게 막는다(hidden은 스크롤바만 숨김).
     clip을 모르는 브라우저는 hidden을 쓴다. 내용 스크롤은 패널이 맡는다. */
  .sheet-sheet {
    overflow: hidden;
    overflow: clip;
  }

  .sheet::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .sheet-panel {
    width: 100%;
    max-width: var(--content-width);
    max-height: 85vh;
    overflow-y: auto;
    padding: 12px 24px calc(24px + env(safe-area-inset-bottom));
    border-radius: 24px 24px 0 0;
    background: var(--color-card);
    box-shadow: var(--shadow-sheet);
    color: var(--color-text);
    animation: sheet-up 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* 손잡이 모양은 40×5px이지만 끌기 영역은 96×28px로 넓힌다. 모양의 위치는 그대로다. */
  .sheet-handle {
    position: relative;
    width: 96px;
    height: 28px;
    margin: -12px auto 5px;
    cursor: grab;
    touch-action: none;
  }

  .sheet-handle::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 5px;
    border-radius: 3px;
    background: var(--color-text-weak);
    opacity: 0.4;
    transform: translate(-50%, -50%);
  }

  /* 검색: 모바일은 화면 전체, 데스크톱은 위쪽 카드 */
  .sheet-full[open] {
    align-items: stretch;
  }

  .sheet-full .sheet-panel {
    height: 100%;
    max-height: none;
    border-radius: 0;
    animation: sheet-fade 0.2s ease;
  }

  @media (min-width: 720px) {
    .sheet-full[open] {
      align-items: flex-start;
      padding-top: 64px;
    }

    .sheet-full .sheet-panel {
      height: auto;
      max-height: 80vh;
      border-radius: 24px;
    }
  }

  @keyframes sheet-up {
    from {
      transform: translateY(100%);
    }
  }

  @keyframes sheet-fade {
    from {
      opacity: 0;
    }
  }
</style>
