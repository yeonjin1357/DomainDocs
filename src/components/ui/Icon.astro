---
import { Activity, BookOpen, ChartColumn, ChartLine, Clock, Cloud, Container, Database, Gauge, Hash, Layers, MessagesSquare, Network, Server, Sigma, Timer, TrendingUp } from '@lucide/astro';
import type { IconName } from '../../data/icons';

interface Props {
  name: IconName;
  size?: number;
}

const ICONS = {
  sigma: Sigma,
  activity: Activity,
  database: Database,
  server: Server,
  'chart-line': ChartLine,
  'chart-column': ChartColumn,
  gauge: Gauge,
  timer: Timer,
  layers: Layers,
  hash: Hash,
  clock: Clock,
  'trending-up': TrendingUp,
  network: Network,
  container: Container,
  cloud: Cloud,
  'messages-square': MessagesSquare,
  'book-open': BookOpen,
} satisfies Record<IconName, unknown>;

const { name, size = 22 } = Astro.props;
const Component = ICONS[name];
---
<Component size={size} aria-hidden="true" />
