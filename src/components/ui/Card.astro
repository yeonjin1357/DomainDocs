---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<section class="card" data-card>
  {title && <h2 class="card-title">{title}</h2>}
  <slot />
</section>

<style>
  .card {
    margin-top: 12px;
    padding: 20px 20px 8px;
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .card-title {
    margin: 0 0 4px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
