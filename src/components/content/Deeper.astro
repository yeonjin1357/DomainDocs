---
import { ChevronDown } from '@lucide/astro';
---
<details class="block deeper" data-block="deeper">
  <summary class="deeper-summary pressable">
    <h2 class="deeper-title">더 깊이 알아보기</h2>
    <ChevronDown class="deeper-chevron" size={20} aria-hidden="true" />
  </summary>
  <div class="deeper-body"><slot /></div>
</details>

<style>
  .deeper-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-radius: 16px;
    background: var(--color-bg);
    font-weight: 600;
    list-style: none;
  }

  .deeper-summary::-webkit-details-marker {
    display: none;
  }

  /* 안의 ### 소제목이 이 제목 아래에 놓이도록 h2로 두되, 모양은 요약 줄 글자 그대로 둔다. */
  .deeper-title {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  .deeper-chevron {
    color: var(--color-text-weak);
    transition: transform 0.2s ease;
  }

  .deeper[open] .deeper-chevron {
    transform: rotate(180deg);
  }

  .deeper-body {
    padding: 20px 4px 0;
  }
</style>
